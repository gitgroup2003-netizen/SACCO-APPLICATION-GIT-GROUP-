# Copy this file to .env and fill in your own Supabase project's values
# (Settings -> API in your Supabase dashboard).
# The anon key is safe to expose publicly — it only works within the
# Row Level Security policies defined in supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
