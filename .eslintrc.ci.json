{
  "root": true,
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module", "ecmaFeatures": { "jsx": true } },
  "env": { "browser": true, "es2022": true },
  "plugins": ["react", "react-hooks"],
  "rules": { "no-undef": "error", "react/jsx-no-undef": "error", "react/jsx-uses-vars": "error", "react-hooks/exhaustive-deps": "off", "no-dupe-keys": "error", "no-unreachable": "error" }
}
